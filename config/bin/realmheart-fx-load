#!/usr/bin/env bash
# Realmheart FX plugin loader.
#
# The plugin is ABI-coupled to the exact Hyprland commit it was built against.
# The plugin API's dirty bit is unreliable in the installed Hyprland 0.56.2
# package, so this loader performs the authoritative version preflight before
# asking Hyprland to mmap the plugin. Plugin.cpp still retains its exact hash
# check and Hyprland retains the PLUGIN_API_VERSION ABI check.
#
# Override the search with REALMHEART_FX_SO=/path/to/realmheart-fx.so.
# The hyprctl and runtime-directory overrides are test/deployment hooks; the
# defaults are the live compositor command and the user's private runtime dir.

set -uo pipefail

readonly expected_commit="${REALMHEART_FX_HYPRLAND_COMMIT:-@REALMHEART_FX_HYPRLAND_COMMIT@}"
readonly expected_abi="${REALMHEART_FX_HYPRLAND_ABI:-@REALMHEART_FX_HYPRLAND_ABI@}"
readonly expected_build_id="${REALMHEART_FX_BUILD_ID:-@REALMHEART_FX_BUILD_ID@}"
readonly canonical_plugin="${REALMHEART_FX_PLUGIN_PATH:-@REALMHEART_FX_PLUGIN_PATH@}"
readonly hyprctl_name="${REALMHEART_FX_HYPRCTL:-hyprctl}"
readonly runtime_dir="${REALMHEART_FX_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/realmheart-fx}"
readonly script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly generated_plugin_relative_dir="@REALMHEART_PLUGIN_RELATIVE_DIR@"

hyprctl_bin="$(command -v "$hyprctl_name" 2>/dev/null || true)"
if [[ -z "$hyprctl_bin" ]]; then
    echo "realmheart-fx: hyprctl not found — is Hyprland running?" >&2
    exit 1
fi

if ! plugin_list_output="$($hyprctl_bin plugin list 2>&1)"; then
    printf '%s\n' "$plugin_list_output" >&2
    echo "realmheart-fx: unable to query the compositor plugin list" >&2
    exit 1
fi
plugin_loaded=false
if grep -Eiq 'realmheart[-_ ]?fx' <<<"$plugin_list_output"; then
    plugin_loaded=true
fi

if ! version_json="$($hyprctl_bin version -j 2>&1)"; then
    printf '%s\n' "$version_json" >&2
    echo "realmheart-fx: unable to query the authoritative Hyprland version" >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "realmheart-fx: python3 is required to parse hyprctl version -j safely" >&2
    exit 1
fi

if ! version_fields="$(printf '%s' "$version_json" | python3 -c '
import json
import sys

try:
    version = json.load(sys.stdin)
    commit = version.get("commit")
    abi = version.get("abiHash")
    dirty = version.get("dirty")
    if not isinstance(commit, str) or not commit:
        raise ValueError("missing commit")
    if not isinstance(abi, str) or not abi:
        raise ValueError("missing abiHash")
    if type(dirty) is not bool:
        raise ValueError("missing boolean dirty flag")
    print(commit)
    print(str(dirty).lower())
    print(abi)
except (json.JSONDecodeError, TypeError, ValueError) as error:
    print(f"invalid version response: {error}", file=sys.stderr)
    raise SystemExit(1)
' )"; then
    echo "realmheart-fx: hyprctl version -j was invalid; refusing to load" >&2
    exit 1
fi

mapfile -t version_values <<<"$version_fields"
runtime_commit="${version_values[0]:-}"
runtime_dirty="${version_values[1]:-}"
runtime_abi="${version_values[2]:-}"

if [[ "$runtime_commit" != "$expected_commit" ]]; then
    echo "realmheart-fx: Hyprland commit mismatch; expected $expected_commit, got ${runtime_commit:-<missing>}" >&2
    exit 1
fi
if [[ "$runtime_abi" != "$expected_abi" ]]; then
    echo "realmheart-fx: Hyprland ABI mismatch; expected $expected_abi, got ${runtime_abi:-<missing>}" >&2
    exit 1
fi
if [[ "$runtime_dirty" != false ]]; then
    echo "realmheart-fx: Hyprland reports a dirty build; refusing to load" >&2
    exit 1
fi

for contract_value in "$expected_commit" "$expected_abi" "$expected_build_id"; do
    if [[ "$contract_value" == @REALMHEART_*@ ]]; then
        echo "realmheart-fx: loader contains unresolved build identity; use the configured/installed loader" >&2
        exit 1
    fi
done

candidates=(
    "${REALMHEART_FX_SO:-}"
    "$canonical_plugin"
    "${script_dir}/${generated_plugin_relative_dir}"
    "${HOME}/Realmheart/build-hybrid/realmheart-fx.so"
    "${HOME}/.local/lib/realmheart-fx.so"
    "/usr/lib/realmheart/realmheart-fx.so"
    "/usr/local/lib/realmheart/realmheart-fx.so"
)

so=""
for candidate in "${candidates[@]}"; do
    if [[ -n "$candidate" && -f "$candidate" && -r "$candidate" ]]; then
        so="$candidate"
        break
    fi
done

if [[ -z "$so" ]]; then
    echo "realmheart-fx: plugin library not found. Enable REALMHEART_BUILD_HYPRLAND_PLUGIN=ON and build against matching Hyprland headers." >&2
    exit 1
fi

verify_loaded_identity() {
    local identity_output loaded_build_id loaded_commit loaded_abi
    if ! identity_output="$($hyprctl_bin realmheart-fx identity 2>&1)"; then
        printf '%s\n' "$identity_output" >&2
        echo "realmheart-fx: compositor lists Realmheart FX but its identity command is unavailable" >&2
        return 1
    fi
    loaded_build_id="$(awk -F= '$1 == "build_id" {print substr($0, index($0, "=") + 1); exit}' <<<"$identity_output")"
    loaded_commit="$(awk -F= '$1 == "hyprland_commit" {print substr($0, index($0, "=") + 1); exit}' <<<"$identity_output")"
    loaded_abi="$(awk -F= '$1 == "hyprland_abi" {print substr($0, index($0, "=") + 1); exit}' <<<"$identity_output")"
    if [[ "$loaded_build_id" != "$expected_build_id" || "$loaded_commit" != "$expected_commit" || "$loaded_abi" != "$expected_abi" ]]; then
        echo "realmheart-fx: loaded plugin identity mismatch; expected build=$expected_build_id commit=$expected_commit abi=$expected_abi, got build=${loaded_build_id:-<missing>} commit=${loaded_commit:-<missing>} abi=${loaded_abi:-<missing>}" >&2
        return 1
    fi
    return 0
}

if [[ "$plugin_loaded" == true ]]; then
    if ! verify_loaded_identity; then
        echo "realmheart-fx: a stale/different Realmheart FX is already loaded; start a fresh Hyprland session to activate the installed build" >&2
        exit 1
    fi
    echo "realmheart-fx: already loaded (verified build $expected_build_id)"
    exit 0
fi

if ! mkdir -p "$runtime_dir" || ! chmod 700 "$runtime_dir"; then
    echo "realmheart-fx: unable to create private runtime directory: $runtime_dir" >&2
    exit 1
fi
if [[ ! -O "$runtime_dir" ]]; then
    echo "realmheart-fx: runtime directory is not owned by the current user: $runtime_dir" >&2
    exit 1
fi

# Every load gets a fresh inode. Never overwrite or remove a prior copy: it
# may still be mmap'd by Hyprland after a failed plugin-init or an unload race.
if ! runtime_plugin="$(mktemp "$runtime_dir/realmheart-fx.XXXXXX.so")"; then
    echo "realmheart-fx: unable to allocate a unique runtime plugin copy" >&2
    exit 1
fi
if ! cp --reflink=auto -- "$so" "$runtime_plugin" || ! chmod 755 "$runtime_plugin"; then
    echo "realmheart-fx: unable to prepare runtime plugin copy: $runtime_plugin" >&2
    exit 1
fi

if ! load_output="$($hyprctl_bin plugin load "$runtime_plugin" 2>&1)"; then
    printf '%s\n' "$load_output" >&2
    echo "realmheart-fx: plugin initialization/load failed: $runtime_plugin" >&2
    exit 1
fi

if ! plugin_list_output="$($hyprctl_bin plugin list 2>&1)"; then
    printf '%s\n' "$plugin_list_output" >&2
    echo "realmheart-fx: plugin load returned success but plugin list could not be read" >&2
    exit 1
fi
if ! grep -Eiq 'realmheart[-_ ]?fx' <<<"$plugin_list_output"; then
    printf '%s\n' "$load_output" >&2
    printf '%s\n' "$plugin_list_output" >&2
    echo "realmheart-fx: compositor did not confirm Realmheart-FX after load: $runtime_plugin" >&2
    exit 1
fi
if ! verify_loaded_identity; then
    echo "realmheart-fx: compositor loaded Realmheart FX but did not attest the expected build identity" >&2
    exit 1
fi

echo "realmheart-fx: loaded $runtime_plugin (source: $so, build: $expected_build_id)"
