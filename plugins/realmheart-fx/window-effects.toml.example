# Realmheart FX assignment configuration.
# Install as ~/.config/realmheart/window-effects.toml, then run:
#   hyprctl realmheart-fx config reload

[windows]
# A quoted string selects one fixed effect.
# A string array randomly selects one effect for each lifecycle event.
# "@all" expands to every registered non-none effect, including compatible
# effects added through future manifests.
open = "@all"
close = "@all"

# Rules are evaluated from top to bottom. The first matching rule that assigns
# the requested direction wins. Matching is case-insensitive. Rules may also
# use fixed effects, explicit random pools, or "@all".
# [[windows.rules]]
# class = "kitty"
# class_match = "exact"
# open = ["aether-sunder", "void"]
# close = "aether-sunder"

# Example: keep Firefox picture-in-picture windows animation-free while normal
# Firefox windows continue to use the randomized defaults above.
# [[windows.rules]]
# class = "firefox"
# class_match = "exact"
# title = "Picture-in-Picture"
# title_match = "contains"
# open = "none"
# close = "none"

# Supported assignment forms:
#   open = "void"                         # fixed
#   open = ["void", "aether-sunder"]     # random explicit pool
#   open = "@all"                         # random all registered effects
# Supported match modes:
#   exact
#   prefix
#   contains
